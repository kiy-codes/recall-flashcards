# Optional. Leave both values blank to keep accounts/cloud disabled.
# Copy to .env.local (ignored by Git). Use a project in a FREE organization.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# URL example: https://your-project-ref.supabase.co
# Key example: sb_publishable_your_public_key
# Legacy alternative, only when not using a publishable key:
# SUPABASE_ANON_KEY=your_legacy_anon_key
# Never put a secret or service_role key in any of these variables.
# These public values are compiled into the browser bundle. Keep service-role,
# signing, database, and private keys out of this project and Vercel env vars.
# AI evaluation is optional. Set GROQ_API_KEY only in Supabase Edge Function
# secrets, never in this client-side .env.local file. GROQ_MODEL is an optional
# server-side secret/setting and defaults to openai/gpt-oss-120b.
