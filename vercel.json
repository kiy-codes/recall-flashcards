{
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist-web",
  "headers": [
    { "source": "/cloud-client.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
